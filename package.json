{
  "name": "tavla-machzorit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "deploy": "npm run build && cd dist && touch .nojekyll && git init -q -b gh-pages && git add -A && git commit -qm deploy && git push -f https://github.com/Anat1969/TavlaMachzorit-GH gh-pages && rm -rf .git"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "d3-force-3d": "^3.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
